{
  "name": "ssd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "astro preview",
    "check": "wrangler types && astro check && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:list:local": "wrangler d1 migrations list DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file scripts/seed-local.sql",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "astro": "7.3.8",
    "drizzle-orm": "0.45.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/node": "24.7.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "oxc-transform-react": "0.145.0",
    "typescript": "5.8.3",
    "wrangler": "4.149.0"
  }
}
